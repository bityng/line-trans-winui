<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LineTrans.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Page.Resources>
        <!-- 文档卡片：Fluent 卡片填充 + 卡片描边 + 8 圆角 -->
        <Style x:Key="DocCardBorderStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="FolderHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Margin" Value="4,12,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="DocTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DocMetaTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="BadgeBorderStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}" />
        <Style x:Key="BadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ChipTextStyle}" />
        <Style x:Key="RowButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
        <Style x:Key="DocProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="EmptyStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PlaceholderTextStyle}">
            <Setter Property="Margin" Value="4,16,0,0" />
        </Style>
        <Style x:Key="DialogHintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}" />
    </Page.Resources>

    <Border Padding="24">
        <Grid RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="文档" Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock x:Name="SummaryText"
                               Text="正在载入文档…"
                               Style="{StaticResource PageSubtitleTextStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="SearchBox"
                             Width="240"
                             PlaceholderText="搜索文档名 / 文件夹 / 正文"
                             TextChanged="OnSearchTextChanged" />

                    <ComboBox x:Name="FilterBox"
                              Width="112"
                              SelectionChanged="OnFilterChanged">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="未完成" />
                        <ComboBoxItem Content="收藏" />
                    </ComboBox>

                    <ComboBox x:Name="SortBox"
                              Width="128"
                              SelectionChanged="OnSortChanged">
                        <ComboBoxItem Content="最近更新" />
                        <ComboBoxItem Content="按名称" />
                        <ComboBoxItem Content="按进度" />
                    </ComboBox>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Click="OnCreateClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="新建文档" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnImportClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="从文件导入" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButtonStyle}" Click="OnRefreshClick" ToolTipService.ToolTip="刷新列表">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="刷新" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListHost" />
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
