<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LineTrans.App.Views.LookupPopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 无边框小窗：显示全局划词查到的词或整句译文 -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border Background="{ThemeResource BgBaseBrush}"
                BorderBrush="{ThemeResource BorderL3Brush}"
                BorderThickness="1"
                Padding="16">
            <StackPanel Spacing="10">

                <!-- 原文 + 标题 + 徽章 -->
                <StackPanel Spacing="6">
                    <TextBlock x:Name="CapturedText"
                               Text=""
                               FontSize="12"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextCaptionBrush}" />

                    <TextBlock x:Name="HeadlineText"
                               Text=""
                               FontSize="18"
                               FontWeight="SemiBold"
                               MaxLines="2"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="PhoneticText"
                                   Text=""
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextSecondaryBrush}" />

                        <Border x:Name="BadgeBorder"
                                CornerRadius="{StaticResource RadiusPill}"
                                Background="{ThemeResource BrandSoftBrush}"
                                Padding="8,2"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="BadgeText"
                                       Text=""
                                       FontSize="11"
                                       Foreground="{ThemeResource BrandTextBrush}" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource BorderL2Brush}" />

                <!-- 释义 / 译文 -->
                <ScrollViewer MaxHeight="260"
                              VerticalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto">
                    <TextBlock x:Name="BodyText"
                               Text=""
                               FontSize="14"
                               LineHeight="22"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                </ScrollViewer>

                <Border Height="1" Background="{ThemeResource BorderL2Brush}" />

                <!-- 操作 -->
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CopyResultButton"
                                Content="复制结果"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32"
                                Click="OnCopyResultClick" />
                        <Button x:Name="CopySourceButton"
                                Content="复制原文"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32"
                                Click="OnCopySourceClick" />
                        <Button x:Name="AddWordButton"
                                Content="加入我的词库"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32"
                                Click="OnAddWordClick" />
                        <Button x:Name="CloseButton"
                                Content="关闭 (Esc)"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="32"
                                Click="OnCloseClick" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText"
                               Text=""
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextCaptionBrush}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
