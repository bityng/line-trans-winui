<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="LineTrans.App.Views.TranslationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:LineTrans.App.Controls"
    Background="Transparent">

    <Page.Resources>
        <!-- 工作区面板：Fluent 卡片（CardBackgroundFillColorDefaultBrush + CardStrokeColorDefaultBrush + 8 圆角） -->
        <Style x:Key="PaneCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- 编辑器：不加边框、透明底，视觉上融进卡片 -->
        <Style x:Key="PaneEditorStyle" TargetType="TextBox">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsSpellCheckEnabled" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- 工具条上的图标按钮：图标 + 文字，高 32 -->
        <Style x:Key="ToolIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
            <Setter Property="Padding" Value="10,0" />
        </Style>

        <Style x:Key="UnitProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
        </Style>

        <DataTemplate x:Key="UnitRowTemplate">
            <Grid ColumnSpacing="8" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Number}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Top"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Preview}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============ 顶部：标题 + 工具条 + 进度 ============ -->
        <Border Grid.Row="0"
                Padding="24,16,24,12"
                BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Spacing="12">
                <TextBlock x:Name="DocTitle" Text="翻译" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Name="DocMeta"
                           Text="还没有打开任何文档"
                           Style="{StaticResource PageSubtitleTextStyle}" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="PrevButton" Style="{StaticResource ToolIconButtonStyle}" Click="OnPrevClick" ToolTipService.ToolTip="上一句">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE76B;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="上一句" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NextButton" Style="{StaticResource ToolIconButtonStyle}" Click="OnNextClick" ToolTipService.ToolTip="下一句">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="下一句" />
                            <FontIcon Glyph="&#xE76C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <TextBlock x:Name="IndexText"
                               Text="第 0 / 0 句"
                               Style="{StaticResource StatusTextStyle}"
                               Margin="4,0" />

                    <NumberBox x:Name="JumpBox"
                               Width="132"
                               Minimum="1"
                               PlaceholderText="跳到第 N 句"
                               SpinButtonPlacementMode="Compact" />
                    <Button Content="跳转" Style="{StaticResource ToolButtonStyle}" Click="OnJumpClick" />

                    <ComboBox x:Name="ModeBox"
                              Width="112"
                              SelectionChanged="OnModeChanged"
                              ToolTipService.ToolTip="切分方式">
                        <ComboBoxItem Content="逐行" />
                        <ComboBoxItem Content="逐句" />
                    </ComboBox>

                    <!-- 布局切换：左原文右译文 / 上原文下译文（设置里也能改，两边同步） -->
                    <ComboBox x:Name="LayoutBox"
                              Width="112"
                              SelectionChanged="OnLayoutChanged"
                              ToolTipService.ToolTip="翻译页布局">
                        <ComboBoxItem Content="左右式" />
                        <ComboBoxItem Content="上下式" />
                    </ComboBox>

                    <Button x:Name="BatchButton" Style="{StaticResource PrimaryButtonStyle}" Click="OnBatchClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="批量翻译剩余" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="StopButton" Style="{StaticResource ToolIconButtonStyle}" IsEnabled="False" Click="OnStopClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE769;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="停止" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ExportButton" Style="{StaticResource ToolIconButtonStyle}" Click="OnExportClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE896;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                            <TextBlock Text="导出" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ProgressBar x:Name="ProgressHost"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Style="{StaticResource UnitProgressBarStyle}" />

                <InfoBar x:Name="MessageBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title=""
                         Message="" />

                <!-- 窄窗口下左右式的降级提示（不擅自改用户的设置，只给一键切换） -->
                <InfoBar x:Name="NarrowBar"
                         IsOpen="False"
                         IsClosable="True"
                         Severity="Informational"
                         Title="窗口比较窄"
                         Message="左右式在窄窗口下会挤在一起，可以切成上下式（上原文下译文）。">
                    <InfoBar.ActionButton>
                        <Button Content="切换为上下式" Style="{StaticResource ToolButtonStyle}" Click="OnSwitchToTopBottomClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>
        </Border>

        <!-- ============ 工作区：布局由代码按设置装配（左右 / 上下） ============ -->
        <Border Grid.Row="1" Padding="16,12,16,12">
            <Grid x:Name="WorkGrid">
                <!-- 句子列表：两种布局下都留在左侧 -->
                <Border x:Name="ListPane" Style="{StaticResource PaneCardStyle}" Margin="0,0,10,0">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="全部句子" Style="{StaticResource FieldLabelTextStyle}" />
                        <ListView x:Name="UnitList"
                                  Grid.Row="1"
                                  SelectionMode="Single"
                                  ItemTemplate="{StaticResource UnitRowTemplate}"
                                  SelectionChanged="OnUnitSelectionChanged" />
                    </Grid>
                </Border>

                <!-- 原文 -->
                <Border x:Name="SourcePane" Style="{StaticResource PaneCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="SourceTitle"
                                   Grid.Row="0"
                                   Text="原文（双击任意单词可查词）"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox x:Name="SourceBox"
                                 Grid.Row="1"
                                 IsReadOnly="True"
                                 Style="{StaticResource PaneEditorStyle}"
                                 DoubleTapped="OnEditorDoubleTapped" />
                        <TextBlock Grid.Row="2"
                                   Text="可选中任意文字复制；双击单词弹出释义浮层。"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                </Border>

                <!-- 可拖拽分隔条：左右式沿 X 拖，上下式沿 Y 拖 -->
                <Grid x:Name="SplitterHost">
                    <Border x:Name="SplitterLine"
                            Width="1"
                            HorizontalAlignment="Center"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <controls:DragSplitter x:Name="Splitter" />
                </Grid>

                <!-- 译文 -->
                <Border x:Name="TargetPane" Style="{StaticResource PaneCardStyle}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TargetTitle"
                                   Grid.Row="0"
                                   Text="译文（可直接编辑）"
                                   Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox x:Name="TargetBox"
                                 Grid.Row="1"
                                 Style="{StaticResource PaneEditorStyle}"
                                 TextChanged="OnTargetTextChanged"
                                 DoubleTapped="OnEditorDoubleTapped" />
                        <StackPanel Grid.Row="2" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="TranslateButton" Style="{StaticResource PrimaryButtonStyle}" Click="OnTranslateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE775;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                        <TextBlock Text="AI 翻译本句" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolIconButtonStyle}" Click="OnCopyClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                        <TextBlock Text="复制" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolIconButtonStyle}" Click="OnPasteSourceClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE77F;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                        <TextBlock Text="粘贴原文" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="StarButton" Style="{StaticResource ToolIconButtonStyle}" Click="OnStarClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="StarIcon" Glyph="&#xE734;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                        <TextBlock x:Name="StarText" Text="收藏" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="DoneButton" Style="{StaticResource ToolIconButtonStyle}" Click="OnDoneClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE73E;" FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="14" />
                                        <TextBlock x:Name="DoneText" Text="标记完成" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ 底部状态条 ============ -->
        <Border Grid.Row="2"
                Padding="24,8,24,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="ModelText" Text="模型：未配置" Style="{StaticResource StatusTextStyle}" />
                <TextBlock x:Name="UsageText" Text="用量：未命中 0 · 命中 0 · 输出 0 token" Style="{StaticResource StatusTextStyle}" />
                <TextBlock x:Name="CostText" Text="估算费用：￥0.000000" Style="{StaticResource StatusTextStyle}" />
                <TextBlock Text="自动保存已开启（离开页面时会强制落盘）" Style="{StaticResource StatusTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
