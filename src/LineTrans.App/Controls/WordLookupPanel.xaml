<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="LineTrans.App.Controls.WordLookupPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Width="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock x:Name="WordText"
                       Text="单词"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextPrimaryBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="PhoneticText"
                           Text=""
                           FontSize="13"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextSecondaryBrush}" />

                <Border x:Name="SourceBadge"
                        CornerRadius="{StaticResource RadiusPill}"
                        Background="{ThemeResource BrandSoftBrush}"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="SourceText"
                               Text="本地词库"
                               FontSize="11"
                               Foreground="{ThemeResource BrandTextBrush}" />
                </Border>

                <TextBlock x:Name="MatchText"
                           Text=""
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextCaptionBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      MaxHeight="240"
                      Margin="0,10,0,10"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <TextBlock x:Name="MeaningText"
                       Text="正在查询…"
                       FontSize="14"
                       LineHeight="22"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextPrimaryBrush}" />
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <Border Height="1" Background="{ThemeResource BorderL2Brush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="复制"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="32"
                        Click="OnCopyClick" />
                <Button Content="加入我的词库"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="32"
                        Click="OnAddClick" />
            </StackPanel>
            <TextBlock x:Name="StatusText"
                       Text=""
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource TextCaptionBrush}" />
        </StackPanel>
    </Grid>
</UserControl>
