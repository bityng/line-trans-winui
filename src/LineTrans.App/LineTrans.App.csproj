<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>LineTrans.App</RootNamespace>
    <AssemblyName>LineTrans.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      应用图标（exe 文件图标 + 任务栏 / Alt+Tab / 开始菜单的默认图标）。
      多尺寸 ico（16/20/24/32/40/48/64/128/256）由 tests\IconTools\make-icon.ps1 生成，
      与托盘图标、安装包图标（tools\installer.iss 的 SetupIconFile）共用同一份资源。
      窗口图标另在 MainWindow 里用 AppWindow.SetIcon 显式设置一次，保证运行期任务栏也是它。
    -->
    <ApplicationIcon>Assets\LineTrans.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- 非打包（unpackaged）运行：直接 dotnet build + 双击 exe 即可，不需要 MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- 本机没有安装 Windows App Runtime，必须自包含（否则运行期找不到 Microsoft.WindowsAppRuntime） -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Product>逐行翻译</Product>
    <AssemblyTitle>逐行翻译</AssemblyTitle>
    <Company>LineTrans</Company>
    <Copyright>Copyright (C) 2026 LineTrans contributors — AGPL-3.0-or-later</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <!--
    纯逻辑类库引用：LineTrans.Core（模型 / 切分 / 导出 / 计费）与
    LineTrans.Dictionary（离线词库 / 查词调度 / 生词本）。
    两者 TFM 都是 net8.0，不含 Windows 专有 API，net8.0-windows10.0.19041.0 可以直接引用。
    两个类库互不依赖，因此各自独立成工程，不互相 ProjectReference。
  -->
  <ItemGroup>
    <ProjectReference Include="..\LineTrans.Core\LineTrans.Core.csproj" />
    <ProjectReference Include="..\LineTrans.Dictionary\LineTrans.Dictionary.csproj" />
  </ItemGroup>

  <!--
    内置离线词库（ECDICT 加工，词典数据部分 MIT 许可，见 Assets\dict\README.md）。
    Assets\ 已被 WinUI 目标隐式收录为 Content 项，这里只能 Update 补元数据；
    再写 Include 会触发 NETSDK1022「重复的 Content 项」错误。
    Link 把输出路径从 Assets\dict\ 提升为 dict\，运行时按 <App 目录>\dict\core.tsv 查找。
  -->
  <ItemGroup>
    <Content Update="Assets\dict\core.tsv" Link="dict\core.tsv" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Assets\dict\lemma.tsv" Link="dict\lemma.tsv" CopyToOutputDirectory="PreserveNewest" />
    <!--
      同一层还有个给人看的 README.md，运行时用不上。
      Assets\ 被 WinUI 目标隐式收成 Content 后会连它一起复制到输出目录（约 1KB 噪声），
      这里显式关掉复制。注意：路径不存在时 Update 只是空操作，不会报错。
    -->
    <Content Update="Assets\dict\README.md" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
