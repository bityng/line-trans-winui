<?xml version="1.0" encoding="utf-8"?>
<!--
  Themes/Styles.xaml —— 逐行翻译 PC 端排版与控件样式（原生 Fluent 版）

  依赖 Colors.xaml（必须在 App.xaml 里先于本文件合并），并且依赖 WinUI 自带的 XamlControlsResources。

  字号一律走 Fluent 标准阶梯，由 BasedOn 指向系统自带样式，不再在控件上写死 FontSize：
    CaptionTextBlockStyle      12   辅助说明 / 字段标签
    BodyTextBlockStyle         14   正文
    BodyStrongTextBlockStyle   14   卡片标题 / 强调正文
    SubtitleTextBlockStyle     20   二级标题
    TitleTextBlockStyle        28   页面标题
  间距用 4 / 8 / 12 / 16 / 24 这套 Fluent 节奏（直接写在控件上，不再自定义字号与色值）。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 文字 ========== -->

    <!-- 页面主标题：Fluent Title（28） -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 页面副标题：Fluent Body（14）+ 次要文字色 -->
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 卡片 / 区块标题：Fluent BodyStrong（14 半粗） -->
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 字段标签：Fluent Caption（12）+ 次要文字色 -->
    <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 说明 / 提示：Fluent Caption（12）+ 三级文字色 -->
    <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- 占位提示（信息密度低的空状态文案） -->
    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- 状态栏文字：Fluent Caption -->
    <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- 标题栏里的应用名 -->
    <Style x:Key="TitleBarTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========== 容器 ========== -->

    <!-- 卡片：Fluent 卡片填充 + 卡片描边 + 8 圆角 -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- 胶囊徽章（许可、词库来源这类小标签） -->
    <Style x:Key="ChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentSubtleBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource ChipCornerRadius}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ChipTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource AccentTextBrush}" />
    </Style>

    <!-- ========== 控件 ========== -->

    <!--
      主按钮：直接用系统 AccentButtonStyle，不再自带 ControlTemplate。
      系统模板自带四态、焦点框、键盘 / 讲述人无障碍与高对比度支持，是「原生控件」的标准形态。

      那「强调色来源 = 品牌蓝」怎么办？—— 不再靠自写模板的悬停 / 按下色，
      改成覆盖 WinUI 的主题资源键（见 Colors.xaml 里的
      AccentFillColorDefaultBrush / AccentFillColorSecondaryBrush / AccentFillColorTertiaryBrush /
      AccentTextFillColorPrimaryBrush）。系统模板读的就是这几个键，
      所以覆盖之后强调按钮、复选框、开关、滑块……整体跟着品牌蓝走，模板仍然是微软那一份。

      只在系统样式之上补三处应用级约定：控件高度用设计令牌、最小宽度 96、左对齐。
    -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 次级按钮：透明底，悬停 / 按下交给系统 Button 模板的 SubtleFill 两态 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 工具条按钮：无边框轻量按钮，密度更高 -->
    <Style x:Key="ToolButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 图标按钮（Segoe Fluent Icons 字形 + 无障碍名称） -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ControlHeight}" />
    </Style>

</ResourceDictionary>
