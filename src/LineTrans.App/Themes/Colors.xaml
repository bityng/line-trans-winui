<?xml version="1.0" encoding="utf-8"?>
<!--
  Themes/Colors.xaml —— 逐行翻译 PC 端设计令牌（原生 Fluent 版）

  设计原则（2026-10 原生化改造）：
    · 表面 / 文字 / 描边 / 交互态一律【直接引用 WinUI 3 自带的 Fluent 主题资源】，
      不再自造网页端那套 #FFFFFF / #F9F9F9 / rgba 描边配色。对照表：
        页面与导航背景  LayerFillColorDefaultBrush（半透明，让 Mica 透出来；无材质时用 SolidBackgroundFillColorBaseBrush）
        卡片 / 面板      CardBackgroundFillColorDefaultBrush + CardStrokeColorDefaultBrush
        次级填充         SolidBackgroundFillColorSecondaryBrush
        主要文字         TextFillColorPrimaryBrush
        次要文字         TextFillColorSecondaryBrush
        三级文字 / 说明  TextFillColorTertiaryBrush
        交互态           SubtleFillColorSecondaryBrush（悬停）/ SubtleFillColorTertiaryBrush（按下）
        分割线           DividerStrokeColorDefaultBrush
        控件描边         ControlStrokeColorDefaultBrush
        强调色文字       AccentTextFillColorPrimaryBrush / 强调色上的文字 TextOnAccentFillColorPrimaryBrush
      这些键随浅色 / 深色 / 高对比度主题自动切换，高对比度下由系统接管，不需要我们再维护三套色板。

    · 本文件只保留两类东西：
        1) 与颜色无关的令牌：圆角、控件高度、标题栏高度、间距；
        2) 强调色（Accent）刷子：默认【跟随系统强调色】，设置里可切成品牌蓝。
           它们刻意做成"可变刷子"——AccentService 直接改 Color 就能全局即时生效，
           不需要重建资源字典，也不需要重新导航页面。

    · 圆角：控件圆角一律用系统默认的 ControlCornerRadius（4），卡片用 Fluent 的 8。
      不再出现网页端的 12 / 16 / 24。

  注意：XML 注释里不能出现连续两个短横线（会触发 XMC9999），下面提到 CSS 变量名时一律省略前导短横线。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         圆角：控件用系统 ControlCornerRadius，卡片用 8，胶囊用大值
         ============================================================ -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ChipCornerRadius">100</CornerRadius>

    <!-- Fluent 常用控件高度是 32 -->
    <x:Double x:Key="ControlHeight">32</x:Double>

    <!-- 自定义标题栏高度：Windows 11 标题栏是 32，留一点余量给应用名与图标 -->
    <x:Double x:Key="TitleBarHeight">48</x:Double>

    <!-- ============================================================
         强调色刷子（可变）
         · 默认值直接绑定系统强调色，所以「跟随系统强调色」是零成本的默认行为，
           AccentService 不跑也是跟随系统的；
         · 选「品牌蓝」时由 AccentService 改这些刷子的 Color（以及按下 / 悬停色）。
         ============================================================ -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{ThemeResource SystemAccentColorLight1}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{ThemeResource SystemAccentColorDark1}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{ThemeResource SystemAccentColor}" />

    <!-- 徽章 / 标签的淡色底：同一支强调色刷子降透明度，两种强调色来源都适用 -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />

    <!-- ============================================================
         接进 WinUI 自带的「强调色主题资源」：让系统控件的模板整体跟着我们的强调色走，
         不用自己写任何 ControlTemplate。

         踩过的坑（实测，别再走一遍）：
           WinUI 的 AccentButtonStyle 取的是 {ThemeResource AccentButtonBackground}，
           而 AccentButtonBackground 在 XamlControlsResources 里是一条
           <StaticResource ResourceKey="AccentFillColorDefaultBrush" /> 别名，
           它绑定的是 WinUI 自己主题字典里那支刷子对象。
           所以【只覆盖 AccentFillColorDefaultBrush 是没用的】——
           实测 system / brand 两种强调色来源下主按钮像素完全一致（都是系统强调色）。
           真正管用的是把 AccentButtonBackground / PointerOver / Pressed 这几个键本身换掉。

         合并顺序保证本文件优先：App.xaml 里 XamlControlsResources 在最前，本文件在它之后，
         合并字典按后进先出查找。

         运行期由 AccentService 直接改这些刷子的 Color，「跟随系统 / 品牌蓝」即时生效；
         这里的值只是启动后那几毫秒的默认值。
         ============================================================ -->

    <!-- 强调按钮（AccentButtonStyle）：填充 / 悬停 / 按下 -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{ThemeResource SystemAccentColorLight1}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{ThemeResource SystemAccentColorDark1}" />

    <!-- 其余读强调色的系统控件：开关 / 复选框 / 单选 / 滑块 / 进度条 -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillIndeterminate" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeIndeterminate" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFill" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStroke" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{ThemeResource SystemAccentColor}" />

    <!-- 超链接 / 强调色文字 -->
    <SolidColorBrush x:Key="HyperlinkButtonForeground" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{ThemeResource SystemAccentColor}" />

    <!-- 基础键：给直接引用它们的地方兜底（有效就生效，无效也无害） -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{ThemeResource SystemAccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{ThemeResource SystemAccentColorLight1}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{ThemeResource SystemAccentColorDark1}" />

</ResourceDictionary>
