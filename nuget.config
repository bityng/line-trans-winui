<?xml version="1.0" encoding="utf-8"?>
<!--
  必须保留这个文件。
  本机 C:\Program Files (x86)\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config
  指向了不存在的 Visual Studio 目录（E:\Packages\Shared\NuGetPackages），
  不清空 fallback 包目录的话，任何 restore 都会以
  NU1301: 本地源"E:\Packages\Shared\NuGetPackages"不存在 失败。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
